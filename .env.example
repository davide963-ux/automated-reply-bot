# ============================================================================
# crypto-x-agent configuration. Copy to .env (never commit .env).
# Safe defaults: DRY_RUN=true, AUTONOMOUS_MODE=false, bot starts PAUSED in the DB.
# ============================================================================

# ---- Safety switches (env-only on purpose: they cannot be flipped from the dashboard) ----
DRY_RUN=true              # true = never call X to publish, only log "WOULD POST"
AUTONOMOUS_MODE=false     # false = every item waits in the approval queue

# ---- Account ----
X_ACCOUNT_HANDLE=         # e.g. mybot (no @). The bot REFUSES to run if the authorized X account differs.
ACCOUNT_TIMEZONE=UTC      # IANA zone; decides when "a day" starts for the daily limits, e.g. Europe/Rome

# ---- Limits (can only LOWER the hard caps 6 posts / 10 replies / 16 total) ----
MAX_POSTS_PER_DAY=6
MAX_REPLIES_PER_DAY=10
MAX_TOTAL_PER_DAY=16
MAX_X_DAILY_SPEND=5       # USD estimate; non-essential X reads stop when reached
MAX_LLM_DAILY_SPEND=5     # USD estimate; the LLM refuses calls when reached (fail closed)

# ---- Database (required). Supabase/Neon: use the pooled URL on serverless and set DB_POOL_MAX=3 ----
DATABASE_URL=postgres://user:password@host:5432/dbname   # falls back to POSTGRES_URL (set by Vercel database integrations)
DATABASE_SSL=false        # true for most managed Postgres
DB_POOL_MAX=10
AUTO_MIGRATE=false        # true = the worker applies sql/*.sql on start

# ---- X (OAuth 2.0 user context). Create the app in the X developer portal ----
X_CLIENT_ID=
X_CLIENT_SECRET=          # leave empty for a public client
X_REDIRECT_URI=           # must be registered as a callback URL in the X portal. Default on Vercel: https://<production domain>/api/x-callback (shown on the dashboard Setup tab); default locally: http://127.0.0.1:3000/callback
# Optional bootstrap only. `npm run x:auth` stores tokens in the DB, which is where they must live
# because refresh tokens can rotate. These are read ONCE if the x_tokens table is empty.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
TOKEN_ENCRYPTION_KEY=     # optional: 64 hex chars (openssl rand -hex 32) to encrypt tokens at rest
X_COST_PER_READ=0.005     # USD per read request, used for the daily spend estimate: set from your X plan
X_COST_PER_WRITE=0.01     # USD per post/reply request

# ---- LLM ("anthropic" or "openai" = any OpenAI-compatible chat API) ----
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=                # model id from your provider, required (no default on purpose)
LLM_BASE_URL=             # optional: gateway / compatible endpoint
LLM_EFFORT=               # anthropic only: low (default for current Claude models) | medium | high | xhigh | max | none
LLM_PRICE_IN_PER_MTOK=3   # USD per million input tokens, for the spend estimate: set from your provider
LLM_PRICE_OUT_PER_MTOK=15

# ---- News ----
NEWS_API_KEY=             # optional: only for sources of kind 'api' (NewsAPI.org-compatible)

# ---- Runtime ----
LOG_LEVEL=info
TICK_INTERVAL_SECONDS=60  # worker mode
PORT=3000                 # worker mode dashboard
DASHBOARD_TOKEN=          # >= 16 chars. Dashboard is disabled without it. Open it with any username + this password
CRON_SECRET=              # >= 16 chars. Protects /api/tick on Vercel (Vercel sends it as a Bearer token)
